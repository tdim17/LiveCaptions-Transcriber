<Page
    x:Class="LiveCaptionsTranscriber.CaptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranscriber"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="CaptionPage"
    JournalEntry.KeepAlive="True"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid Margin="5,5,15,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style x:Key="CaptionBlockStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>

        <!-- Current Sentence -->
        <ui:Card
            Grid.Row="0"
            Padding="8"
            VerticalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="CurrentSentence"
                    Grid.Column="0"
                    Background="Transparent"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Style="{StaticResource CaptionBlockStyle}"
                    Text="{Binding DisplayOriginalCaption, UpdateSourceTrigger=PropertyChanged}"
                    Foreground="DodgerBlue" />
                <TextBlock
                    Grid.Column="1"
                    Text="Current"
                    FontSize="12"
                    Foreground="Gray"
                    VerticalAlignment="Top"
                    Margin="10,0,0,0" />
            </Grid>
        </ui:Card>

        <!-- Control Buttons -->
        <ui:Card
            Grid.Row="1"
            Margin="0,5,0,0"
            Padding="8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button
                        x:Name="StartButton"
                        Content="Start Recording"
                        Margin="0,0,8,0"
                        Padding="15,8"
                        Click="StartButton_Click"
                        Appearance="Danger" />
                    <ui:Button
                        x:Name="PauseButton"
                        Content="Pause"
                        Margin="0,0,8,0"
                        Padding="15,8"
                        Click="PauseButton_Click"
                        Appearance="Secondary" />
                    <ui:Button
                        x:Name="ResumeButton"
                        Content="Resume"
                        Margin="0,0,8,0"
                        Padding="15,8"
                        Click="ResumeButton_Click"
                        Appearance="Danger" />
                    <ui:Button
                        x:Name="StopButton"
                        Content="Stop"
                        Padding="15,8"
                        Click="StopButton_Click"
                        Appearance="Secondary" />
                </StackPanel>
                <Border
                    x:Name="RecordingStatusBanner"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    CornerRadius="5"
                    Padding="18,5">
                    <TextBlock
                        x:Name="RecordingStatusText"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="Ready — press Start Recording" />
                </Border>
                <TextBlock
                    x:Name="TranscriptFileText"
                    Margin="0,3,0,0"
                    HorizontalAlignment="Center"
                    Foreground="Gray"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <StackPanel
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
                    <ui:Button
                        x:Name="CopyButton"
                        Content="Copy All"
                        Margin="0,0,10,0"
                        Padding="15,8"
                        Click="CopyButton_Click"
                        Icon="{ui:SymbolIcon Copy16}" />
                    <ui:Button
                        x:Name="ClearButton"
                        Content="Clear"
                        Padding="15,8"
                        Click="ClearButton_Click"
                        Icon="{ui:SymbolIcon Delete16}"
                        Appearance="Secondary" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <!-- Full Transcription -->
        <ui:Card
            Grid.Row="2"
            Margin="0,5,0,0"
            Padding="8">
            <ScrollViewer
                x:Name="TranscriptionScrollViewer"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <TextBlock
                    x:Name="FullTranscription"
                    Background="Transparent"
                    FontSize="14"
                    LineHeight="22"
                    Style="{StaticResource CaptionBlockStyle}"
                    Text="{Binding FullTranscriptionText, UpdateSourceTrigger=PropertyChanged}"
                    Cursor="Hand"
                    MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                    ToolTip="Click to Copy"
                    MinHeight="100" />
            </ScrollViewer>
        </ui:Card>

    </Grid>
</Page>
