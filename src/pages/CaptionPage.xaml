<Page
    x:Class="LiveCaptionsTranscriber.CaptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranscriber"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="CaptionPage"
    JournalEntry.KeepAlive="True"
    ScrollViewer.CanContentScroll="False"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid Margin="5,5,15,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style x:Key="CaptionBlockStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>

        <!-- Current Sentence -->
        <ui:Card
            Grid.Row="0"
            Height="84"
            Padding="8"
            VerticalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="CurrentSentence"
                    Grid.Column="0"
                    Background="Transparent"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Style="{StaticResource CaptionBlockStyle}"
                    Text="{Binding DisplayOriginalCaption, UpdateSourceTrigger=PropertyChanged}"
                    Foreground="DodgerBlue"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="Current"
                    FontSize="12"
                    Foreground="Gray"
                    VerticalAlignment="Top"
                    Margin="10,0,0,0" />
            </Grid>
        </ui:Card>

        <!-- Control Buttons -->
        <ui:Card
            Grid.Row="1"
            Margin="0,5,0,0"
            Padding="8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button
                        x:Name="StartButton"
                        Content="Start Recording"
                        Margin="0,0,8,0"
                        Padding="15,8"
                        Click="StartButton_Click"
                        Appearance="Primary"
                        Background="#E60000"
                        BorderBrush="#E60000"
                        Foreground="#FFFFFF" />
                    <ui:Button
                        x:Name="PauseButton"
                        Content="Pause"
                        Margin="0,0,8,0"
                        Padding="15,8"
                        Click="PauseButton_Click"
                        Appearance="Secondary"
                        Background="#F0F0F0"
                        BorderBrush="#B8B8B8" />
                    <ui:Button
                        x:Name="ResumeButton"
                        Content="Resume"
                        Margin="0,0,8,0"
                        Padding="15,8"
                        Click="ResumeButton_Click"
                        Appearance="Primary"
                        Background="#E60000"
                        BorderBrush="#E60000"
                        Foreground="#FFFFFF" />
                    <ui:Button
                        x:Name="StopButton"
                        Content="Stop"
                        Padding="15,8"
                        Click="StopButton_Click"
                        Appearance="Secondary"
                        Background="#F0F0F0"
                        BorderBrush="#B8B8B8" />
                </StackPanel>
                <Border
                    x:Name="RecordingStatusBanner"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    CornerRadius="5"
                    Padding="18,5">
                    <TextBlock
                        x:Name="RecordingStatusText"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="Ready — press Start Recording" />
                </Border>
                <StackPanel
                    Margin="0,3,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        x:Name="TranscriptFileText"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="Gray"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <ui:Button
                        x:Name="OpenResultsButton"
                        Width="30"
                        Height="26"
                        Margin="5,0,0,0"
                        Appearance="Transparent"
                        Click="OpenResultsButton_Click"
                        Icon="{ui:SymbolIcon FolderOpen20}"
                        ToolTip="Open Results_txt folder" />
                </StackPanel>
                <StackPanel
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
                    <ui:Button
                        x:Name="CopyButton"
                        Width="42"
                        Height="36"
                        Margin="0,0,6,0"
                        Click="CopyButton_Click"
                        Icon="{ui:SymbolIcon Copy20}"
                        ToolTip="Copy all" />
                    <ui:Button
                        x:Name="ClearButton"
                        Width="42"
                        Height="36"
                        Margin="0,0,6,0"
                        Click="ClearButton_Click"
                        Icon="{ui:SymbolIcon Delete20}"
                        Appearance="Secondary"
                        ToolTip="Clear editable text" />
                    <ui:Button
                        x:Name="EditButton"
                        Width="42"
                        Height="36"
                        Margin="0,0,6,0"
                        Click="EditButton_Click"
                        Icon="{ui:SymbolIcon Edit20}"
                        ToolTip="Edit transcript while paused" />
                    <ui:Button
                        x:Name="UndoButton"
                        Width="42"
                        Height="36"
                        Margin="0,0,6,0"
                        Click="UndoButton_Click"
                        Icon="{ui:SymbolIcon ArrowUndo20}"
                        ToolTip="Undo last edit" />
                    <ui:Button
                        x:Name="SaveAsButton"
                        Width="42"
                        Height="36"
                        Margin="0,0,6,0"
                        Click="SaveAsButton_Click"
                        Icon="{ui:SymbolIcon Save20}"
                        ToolTip="Save As and stop" />
                    <ui:Button
                        x:Name="ApplyEditButton"
                        Width="42"
                        Height="36"
                        Margin="0,0,6,0"
                        Click="ApplyEditButton_Click"
                        Icon="{ui:SymbolIcon Checkmark20}"
                        ToolTip="Apply transcript edits"
                        Visibility="Collapsed" />
                    <ui:Button
                        x:Name="CancelEditButton"
                        Width="42"
                        Height="36"
                        Click="CancelEditButton_Click"
                        Icon="{ui:SymbolIcon Dismiss20}"
                        ToolTip="Cancel transcript edits"
                        Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <!-- Full Transcription -->
        <ui:Card
            Grid.Row="2"
            Margin="0,5,0,0"
            Padding="8"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <ScrollViewer
                x:Name="TranscriptionScrollViewer"
                HorizontalAlignment="Stretch"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                VerticalAlignment="Stretch">
                <TextBox
                    x:Name="FullTranscription"
                    AcceptsReturn="True"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="14"
                    TextBlock.LineHeight="22"
                    Padding="0,0,15,0"
                    IsReadOnly="True"
                    IsUndoEnabled="True"
                    UndoLimit="100"
                    TextWrapping="Wrap"
                    Text="{Binding FullTranscriptionText, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="FullTranscription_TextChanged"
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    MinHeight="100" />
            </ScrollViewer>
        </ui:Card>

    </Grid>
</Page>
