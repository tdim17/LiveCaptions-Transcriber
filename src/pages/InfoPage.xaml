<Page
    x:Class="LiveCaptionsTranscriber.InfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranscriber"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="InfoPage"
    JournalEntry.KeepAlive="False"
    mc:Ignorable="d">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock TextAlignment="Left" TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="LiveCaptions Transcriber" />
                <Run Text="&#x0A;&#x0A;A focused transcription tool that enhances Windows LiveCaptions with better UI, continuous text display, and easy copy/clear functionality." />
                <Run Text="&#x0A;&#x0A;Perfect for:" />
                <Run Text="&#x0A;📝 Meeting notes and lectures" />
                <Run Text="&#x0A;🎮 Gaming and streaming overlays" />
                <Run Text="&#x0A;♿️ Accessibility and hearing assistance" />
                <Run Text="&#x0A;📚 Content creation and documentation" />
            </TextBlock>
            <Separator Margin="0,10,0,10" />
            <TextBlock Margin="0,0,0,3">
                <Run FontWeight="SemiBold" Text="Original project:" />
                <Hyperlink NavigateUri="https://github.com/SakiRinn/LiveCaptions-Translator" RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="LiveCaptions-Translator by @SakiRinn" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,0,0,3">
                <Run FontWeight="SemiBold" Text="Based on:" />
                <Hyperlink NavigateUri="https://github.com/darshankparmar/LiveCaptions-Transcriber" RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="LiveCaptions-Transcriber by @darshankparmar" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,0,0,3">
                <Run FontWeight="SemiBold" Text="Modified by:" />
                <Run Text="tdim17" />
            </TextBlock>
            <TextBlock Margin="0,0,0,3">
                <Run FontWeight="SemiBold" Text="Purpose:" />
                <Run Text="Reliable capture and storage of Windows Live Captions" />
            </TextBlock>
            <TextBlock Margin="0,0,0,3">
                <Run FontWeight="SemiBold" Text="Source code:" />
                <Hyperlink NavigateUri="https://github.com/tdim17/LiveCaptions-Transcriber" RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="https://github.com/tdim17/LiveCaptions-Transcriber" />
                </Hyperlink>
            </TextBlock>
            <TextBlock>
                <Run FontWeight="SemiBold" Text="Version:" />
                <Run x:Name="Version" Text="1.2.0" />
            </TextBlock>
        </StackPanel>
    </Grid>
</Page>
